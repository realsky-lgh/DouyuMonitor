{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC + vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QT_ROOT": "$env{QT_ROOT}",
        "MPV_ROOT": "$env{MPV_ROOT}"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (MSVC + vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QT_ROOT": "$env{QT_ROOT}",
        "MPV_ROOT": "$env{MPV_ROOT}"
      }
    },
    {
      "name": "windows-x64-beta24",
      "displayName": "Windows x64 Release (24-room full-decode beta)",
      "inherits": "windows-x64-release",
      "binaryDir": "${sourceDir}/out/build/windows-x64-beta24",
      "cacheVariables": {
        "DOUYU_ROOM_CAPACITY_PHASE24": "ON"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release (system Qt 6 + libmpv)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-x64-beta24",
      "configurePreset": "windows-x64-beta24"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-beta24",
      "configurePreset": "windows-x64-beta24",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
